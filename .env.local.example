# Local Compose deployment example.
# Copy to .env.local or export these variables before running Make targets:
#   set -a; source .env.local; set +a

# Required only for the opt-in Compose seed service; leave blank for UI setup.
# The repository does not resolve Cognis credential IDs; callers may populate
# these from credential id "litellm" externally.
COGNIS_LOCAL_LLM_BASE_URL=https://api.groq.com/openai/v1
COGNIS_LOCAL_LLM_API_KEY=

# Leave both blank for interactive first-account setup.
# Set both only to auto-create an administrator in a private development stack.
COGNIS_LOCAL_ADMIN_EMAIL=
COGNIS_LOCAL_ADMIN_PASSWORD=
COGNIS_LOCAL_ADMIN_NAME=Local Admin

# Recommended cheap defaults; any OpenAI-compatible endpoint/model can be used.
COGNIS_LOCAL_CHAT_MODEL=openai/gpt-oss-120b
INTARIS_EVALUATOR_BACKEND=auto
# Configure companion lite/smart/embedding models in Settings > Routing.
# Dimensions must match the selected embedding model and existing collections.
MNEMORY_EMBED_DIMS=1536
INTARIS_SEARCH_EMBEDDING_DIM=1536
INTARIS_SEARCH_SPARSE_MODEL=Qdrant/bm25

# Published dependency images. Pin these in reproducible environments.
MNEMORY_IMAGE=ghcr.io/fpytloun/mnemory:latest
INTARIS_IMAGE=ghcr.io/fpytloun/intaris:latest

# Cognis builds from this repository by default. Set these only when using
# prebuilt images through a compose override workflow.
COGNIS_IMAGE=cognis-local:latest
COGNIS_EXECUTOR_IMAGE=cognis-executor-local:latest

# Host ports.
COGNIS_PORT=8080
MNEMORY_PORT=8050
MNEMORY_MGMT_PORT=9090
INTARIS_PORT=8060
QDRANT_PORT=6333
